<?xml version='1.0' encoding='utf-8'?>
<widget id="com.juba.calculator" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>JUBA Calculator</name>
    <description>A modern, professional calculator app.</description>
    <author email="dev@juba.com" href="https://github.com/codejubaweb">JUBA</author>
    <content src="index.html" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <preference name="KeepRunning" value="true"/>
    <preference name="Fullscreen" value="true" />
    <preference name="Orientation" value="portrait" />
</widget>
